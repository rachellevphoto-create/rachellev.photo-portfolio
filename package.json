{
  "name": "photography-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://rachellevphoto-create.github.io/rachellev.photo-portfolio/",
  "scripts": {
    "predev": "env -u NODE_OPTIONS node scripts/optimize-images.mjs",
    "dev": "env -u NODE_OPTIONS vite",
    "images": "env -u NODE_OPTIONS node scripts/optimize-images.mjs",
    "build": "env -u NODE_OPTIONS sh -c \"node scripts/optimize-images.mjs && tsc -b && vite build\"",
    "lint": "env -u NODE_OPTIONS eslint .",
    "preview": "env -u NODE_OPTIONS vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  }
}
